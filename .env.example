# Copy to .env and fill in. Never commit .env.

# Claude access. The key is read only by the backend; it is never sent to the
# browser, written to the audit log, or included in a prompt or error message.
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-haiku-5-5

# Shared secret for admin endpoints, sent as the X-Admin-Token header.
# Use a long random value.
ADMIN_TOKEN=

# DEMO_MODE=1 enables the demo-only endpoints (audit tamper, beacon
# simulation). Set to 0 outside a demo.
DEMO_MODE=1

# Optional: mirror administrator alerts to Telegram. Leave blank to disable.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
